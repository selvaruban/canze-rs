#!/bin/sh

# Define variables
CANZE_EXECUTABLE="/usr/local/bin/canze-rs"
PID_FILE="/var/run/canze-rs.pid"
LOG_FILE="/var/log/canze-rs.log"
ARGS="--debug"

# Ensure the log and PID file directories exist
mkdir -p $(dirname $PID_FILE)
mkdir -p $(dirname $LOG_FILE)

# Function to check if the program is running
is_running() {
    if [ -f "$PID_FILE" ]; then
        PID=$(cat "$PID_FILE")
        if [ -n "$PID" ] && ps -p "$PID" > /dev/null; then
            return 0
        fi
    fi
    return 1
}

# The main logic for handling arguments
case "$1" in
    start)
        if is_running; then
            echo "canze-rs is already running."
            exit 1
        fi
        echo "Starting canze-rs..."
        # Run the executable in the background and redirect output to a log file
        nohup "$CANZE_EXECUTABLE" $ARGS > "$LOG_FILE" 2>&1 &
        # Save the process ID to the PID file
        echo $! > "$PID_FILE"
        echo "canze-rs started with PID $!."
        ;;

    stop)
        if ! is_running; then
            echo "canze-rs is not running."
            exit 1
        fi
        echo "Stopping canze-rs..."
        kill $(cat "$PID_FILE")
        rm "$PID_FILE"
        echo "canze-rs stopped."
        ;;

    restart)
        $0 stop
        sleep 2
        $0 start
        ;;

    status)
        if is_running; then
            echo "canze-rs is running with PID $(cat "$PID_FILE")."
        else
            echo "canze-rs is not running."
        fi
        ;;

    *)
        echo "Usage: $0 {start|stop|restart|status}"
        exit 1
        ;;
esac
exit 0
